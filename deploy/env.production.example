# Copy to /opt/licensegraph/.env (chmod 600) and fill in. Never commit the real file.

# The public address of this server, exactly as users and PayPal will reach it.
# With Tailscale Funnel this is https://<machine-name>.<your-tailnet>.ts.net
APP_URL=https://CHANGE-ME.ts.net

# Where runs (and so passports) are stored. Back this folder up.
LICENSEGRAPH_DATA_DIR=/var/lib/licensegraph

# PayPal SANDBOX credentials from developer.paypal.com (Apps & Credentials, Sandbox, Merchant app).
# Use United States Sandbox accounts. Never put live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: pay real Sandbox accounts for the demo creators (comma separated Sandbox personal account emails).
LICENSEGRAPH_CREATOR_EMAILS=

# AI Gateway key and a FREE model id (the app refuses any model the gateway does not list as free).
AI_GATEWAY_API_KEY=
LICENSEGRAPH_MODEL=
# Requests per minute the free model allows (default 5)
LICENSEGRAPH_MODEL_RPM=5

# Signs Licence Passports so this server can later confirm it issued them. Generate with: openssl rand -hex 32
LICENSEGRAPH_PASSPORT_SECRET=

# AG Studio licence key (removes the trial watermark on the dashboard)
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
