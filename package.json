{
  "name": "licensegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Verified licence bundles for AI-era creative projects: propose, verify, reject, revise, then pay.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "RUN_PAYPAL_SANDBOX=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/paypal.live.test.ts",
    "test:gateway": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/extraction.live.test.ts",
    "test:proposer": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/proposer.live.test.ts",
    "sandbox:order": "tsx --env-file=.env scripts/sandbox-order.ts",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "node scripts/demo.mjs --build-only && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "ag-studio": "^3.0.0",
    "ag-studio-react": "^3.0.0",
    "lucide-react": "^1.62.0",
    "next": "^15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
