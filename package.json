{
  "name": "licensegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Verified licence bundles for AI-era creative projects: propose, verify, reject, revise, then pay.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "RUN_PAYPAL_SANDBOX=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/paypal.live.test.ts",
    "test:gateway": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/extraction.live.test.ts",
    "test:proposer": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/proposer.live.test.ts",
    "sandbox:order": "tsx --env-file=.env scripts/sandbox-order.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  }
}
