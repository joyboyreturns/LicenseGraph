{
  "name": "licensegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Verified licence bundles for AI-era creative projects: propose, verify, reject, revise, then pay.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:live": "RUN_PAYPAL_SANDBOX=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/paypal.live.test.ts",
    "test:gateway": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/extraction.live.test.ts",
    "test:proposer": "RUN_GATEWAY_LIVE=1 node --env-file=.env ./node_modules/vitest/vitest.mjs run tests/proposer.live.test.ts",
    "sandbox:order": "tsx --env-file=.env scripts/sandbox-order.ts",
    "demo": "node scripts/demo.mjs",
    "openapi": "tsx scripts/openapi.ts",
    "verify:passport": "tsx scripts/verify-passport.ts",
    "test:e2e": "node scripts/demo.mjs --build --build-only && playwright test",
    "infra:init": "node --import tsx scripts/local-infra.ts",
    "db:migrate": "node --env-file-if-exists=.env.local-infra --import tsx scripts/database-migrate.ts",
    "worker": "node --env-file-if-exists=.env.local-infra --import tsx scripts/marketplace-worker.ts",
    "test:database": "node --env-file-if-exists=.env.local-infra scripts/database-tests.mjs",
    "identity:setup": "node --env-file=.env.local-infra --import tsx scripts/keycloak-setup.ts",
    "identity:fixtures": "node --env-file=.env.local-infra --import tsx scripts/identity-fixtures.ts",
    "test:marketplace-browser": "node --env-file=.env.local-infra ./node_modules/playwright/cli.js test --config playwright.marketplace.config.ts",
    "db:import-legacy": "node --env-file-if-exists=.env.local-infra --import tsx scripts/import-legacy.ts",
    "db:rekey": "node --env-file-if-exists=.env.local-infra --import tsx scripts/database-rekey.ts",
    "db:backup": "node --env-file-if-exists=.env.local-infra --import tsx scripts/database-backup.ts",
    "db:restore": "node --env-file-if-exists=.env.local-infra --import tsx scripts/database-restore.ts",
    "build:ops": "node scripts/build-ops.mjs",
    "package": "LICENSEGRAPH_STANDALONE=1 npm run build && npm run build:ops && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "fast-check": "^3.23.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ag-studio": "^3.0.0",
    "ag-studio-react": "^3.0.0",
    "lucide-react": "^1.62.0",
    "next": "^15.5.28",
    "openid-client": "^6.8.9",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
