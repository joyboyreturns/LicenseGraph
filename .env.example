# Vercel AI Gateway (agent calls go through it)
AI_GATEWAY_API_KEY=
# Gateway model id in "provider/model" form; set when the agent step is built
LICENSEGRAPH_MODEL=

# PayPal Sandbox (Orders v2). Never use live credentials in this repo.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# App
# Public URL PayPal sends the buyer back to after approving (set to your deployed URL)
APP_URL=http://localhost:3000
# "demo" runs on the built-in sample licences with no model; "live" uses the gateway.
# Unset: live when AI_GATEWAY_API_KEY and LICENSEGRAPH_MODEL are both set, otherwise demo.
LICENSEGRAPH_MODE=
