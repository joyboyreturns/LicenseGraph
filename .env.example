# Copy to .env for local development. Never commit the real file.
# With no .env at all, `npm run demo` runs the whole app offline (replayed scenarios, payment simulator).

# --- App ----------------------------------------------------------------------------------------
# Public address of this server. PayPal sends the buyer back here and passport QR codes point at it.
APP_URL=http://localhost:3000
# Where runs (and so passports) are stored.
LICENSEGRAPH_DATA_DIR=./.data
# Signs Licence Passports so this server can later confirm it issued them. Generate: openssl rand -hex 32
LICENSEGRAPH_PASSPORT_SECRET=

# --- Payments ------------------------------------------------------------------------------------
# PayPal SANDBOX credentials: developer.paypal.com > Apps & Credentials > Sandbox > Merchant app.
# Use United States Sandbox accounts (India-region accounts cannot transact in USD). Never use live credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set to 0 only if the Sandbox checkout rejects itemised orders (default 1).
LICENSEGRAPH_ITEMISED_ORDERS=1
# Optional: the id of the Sandbox webhook pointing at <your public URL>/api/webhooks/paypal (see README, "Webhooks").
PAYPAL_WEBHOOK_ID=
# No PayPal account? Run a clearly labelled local payment simulator instead (no money moves):
LICENSEGRAPH_SIMULATOR=
# Force a backend: "simulator" or "none" (default: PayPal Sandbox when credentials exist).
LICENSEGRAPH_PAYMENTS=
# Pay real Sandbox accounts for the demo creators (comma separated Sandbox personal account emails).
LICENSEGRAPH_CREATOR_EMAILS=

# --- AI ------------------------------------------------------------------------------------------
# Vercel AI Gateway key and a FREE model id. The app refuses any model the gateway does not list as
# free, so credits cannot be spent. Without these, built-in scenarios still work (recorded output).
AI_GATEWAY_API_KEY=
LICENSEGRAPH_MODEL=
# Requests per minute the free model allows; model calls are spaced to stay inside it (default 5).
LICENSEGRAPH_MODEL_RPM=5
# Completion deadline in milliseconds (default 100000); a hung request fails visibly.
LICENSEGRAPH_MODEL_TIMEOUT_MS=100000
# "demo" = replayed scenarios only; "live" = your own licences go through the model.
# Unset: live when a gateway key and model are set, otherwise demo.
LICENSEGRAPH_MODE=

# --- Dashboard -----------------------------------------------------------------------------------
# AG Studio is commercial; without a licence key it runs with a trial watermark.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=
